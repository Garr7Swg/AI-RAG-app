# ============================================================================
# Copy to .env  ->  cp .env.example .env   (never commit .env)
# Every value below has a safe default for local / Codespaces use.
# ============================================================================

# ---------- Paths ----------
RAG_CORPUS_DIR=data/corpus
RAG_STORAGE_DIR=storage
RAG_EVAL_DIR=eval
RAG_SAMPLES_DIR=data/eval

# ---------- Chunking ----------
RAG_CHUNK_MAX_CHARS=1400
RAG_CHUNK_MIN_CHARS=240
RAG_SEMANTIC_PERCENTILE=88
RAG_MAX_FILE_MB=10

# ---------- Retrieval ----------
RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_TOP_K_DENSE=20
RAG_TOP_K_BM25=20
RAG_TOP_K_FINAL=5
RAG_RERANK_MIN_SCORE=0.15
RAG_VECTOR_BACKEND=chroma            # chroma | pinecone
RAG_COLLECTION=enterprise_docs

# ---------- Generation ----------
# Groq (free tier) is the default hosted provider: no GPU, no local model, and
# it is the only option that works on Streamlit Community Cloud.
# Note: Groq retired llama-3.1-8b-instant / llama-3.3-70b-versatile for free and
# developer tiers on 2026-08-16. The current free models are the gpt-oss ones.
# Unset RAG_LLM_PROVIDER -> local Ollama. Use openai_compat for any hosted
# deployment (Groq here), or auto = Groq when the key is set, else Ollama.
RAG_LLM_PROVIDER=openai_compat
RAG_OPENAI_BASE_URL=https://api.groq.com/openai/v1
RAG_OPENAI_MODEL=openai/gpt-oss-20b
# RAG_OPENAI_MODEL=openai/gpt-oss-120b   # stronger answers, still free tier
RAG_OPENAI_API_KEY=gsk_replace_me

# Offline alternative: local Ollama (free, no key). Comment out the block above,
# set RAG_LLM_PROVIDER=ollama, and start `ollama serve`. A 3B Q4 model fits an
# RTX 2060 6 GB.
# RAG_LLM_PROVIDER=ollama
# RAG_OLLAMA_URL=http://localhost:11434
# RAG_OLLAMA_MODEL=qwen2.5:3b-instruct
RAG_TEMPERATURE=0.0
RAG_MAX_ANSWER_TOKENS=512
RAG_LLM_TIMEOUT_S=120

# ---------- Guardrails ----------
RAG_GROUNDING_MIN_OVERLAP=0.30
RAG_STRICT_NUMERIC=true
RAG_MAX_QUESTION_CHARS=1200
RAG_RATE_LIMIT_PER_MIN=20

# ---------- Auth (Supabase) ----------
# Leave blank to run in local demo mode (single synthetic user, clearly labelled).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Only needed if your project still signs JWTs with the legacy shared secret.
SUPABASE_JWT_SECRET=
RAG_ADMIN_EMAILS=you@example.com
RAG_SESSION_TIMEOUT_MIN=120
# Public origin of the running app, used as the redirect target for Supabase
# confirmation emails. Blank locally -> falls back to the Supabase "Site URL".
# On Streamlit Cloud / Codespaces set the real origin, e.g.
#   RAG_PUBLIC_URL=https://your-app.streamlit.app
RAG_PUBLIC_URL=

# ---------- Optional: Pinecone free tier ----------
PINECONE_API_KEY=
PINECONE_INDEX=rag-enterprise
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
